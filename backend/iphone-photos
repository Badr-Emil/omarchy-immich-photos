def run(command, timeout=10):
    """Run a command, returning (exit code, stdout, stderr). Never raises."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except FileNotFoundError:
        return 127, "", "%s: command not found" % command[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out" % command[0]


def docker_installed():
    return shutil.which("docker") is not None


def docker_direct():
    """True when this user may talk to the Docker daemon without a prompt."""
    return os.access(DOCKER_SOCKET, os.R_OK | os.W_OK)


def docker_daemon_active():
    code, out, _ = run(["systemctl", "is-active", "docker.service"])
    return out == "active"


def docker_enabled_at_boot():
    code, out, _ = run(["systemctl", "is-enabled", "docker.service"])
    return out == "enabled"


def compose_version():
    code, out, _ = run(["docker", "compose", "version", "--short"])
    return out if code == 0 and out else None


def engine_version():
    code, out, _ = run(["docker", "--version"])
    match = re.search(r"version\s+([^\s,]+)", out)
    return match.group(1) if code == 0 and match else None


def running_compose_dirs():
    """Directories of compose projects named like Immich. Needs daemon access."""
    if not (docker_installed() and docker_direct()):
        return []
    code, out, _ = run(["docker", "compose", "ls", "-a", "--format", "json"])
    if code != 0:
        return []
    try:
        projects = json.loads(out)
    except ValueError:
        return []
    directories = []
    for project in projects:
        if "immich" in str(project.get("Name", "")).lower():
            for config_file in str(project.get("ConfigFiles", "")).split(","):
                if config_file:
                    directories.append(Path(config_file).parent)
    return directories


def container_states(installation):
    """Per-container state, or None when the daemon is not accessible."""
    if not (installation.installed and docker_installed() and docker_direct()):
        return None
    code, out, _ = run(["docker", "compose", "--project-directory", str(installation.compose_dir),
                        "ps", "-a", "--format", "json"])
    if code != 0:
        return None
    return parse_compose_ps(out)


def parse_compose_ps(output):
    """`docker compose ps --format json` prints a JSON array or one object per line."""
    output = output.strip()
    if not output:
        return []
    try:
        rows = json.loads(output)
        rows = rows if isinstance(rows, list) else [rows]
    except ValueError:
        rows = []
        for line in output.splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    return [{"name": row.get("Name", ""), "service": row.get("Service", ""),
             "state": row.get("State", ""), "health": row.get("Health", "")}
            for row in rows if isinstance(row, dict)]


def port_listening(port, host="127.0.0.1"):
    try:
        with socket.create_connection((host, port), timeout=1):
            return True
    except OSError:
        return False


def outbound_address():
    """Address of the interface that carries the default route. Sends nothing."""
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("192.0.2.1", 9))
        return probe.getsockname()[0]
    except OSError:
        return None
    finally:
        probe.close()


def lan_ip(candidate=None):
    """Private LAN address of this PC, or None when there is none.

    Rejects loopback, link-local, public and carrier-grade NAT addresses, so a
    VPN address such as Tailscale's 100.64.0.0/10 is never offered to the phone.
    """
    candidate = outbound_address() if candidate is None else candidate
    try:
        address = ipaddress.ip_address(candidate)
    except (TypeError, ValueError):
        return None
    if address.version != 4 or address.is_loopback or address.is_link_local or not address.is_private:
        return None
    return str(address)


def mount_info(path):
    """Mount that holds `path`: target, source, fstype, options."""
    code, out, _ = run(["findmnt", "-J", "-T", str(path), "-o", "TARGET,SOURCE,FSTYPE,OPTIONS"])
    if code != 0:
        return None
    try:
        entry = json.loads(out)["filesystems"][0]
    except (ValueError, KeyError, IndexError):
        return None
    return {"target": entry.get("target"), "source": entry.get("source"),
            "fstype": entry.get("fstype"), "options": (entry.get("options") or "").split(",")}


def disk_usage(path):
    stats = os.statvfs(path)
    total = stats.f_blocks * stats.f_frsize
    free = stats.f_bavail * stats.f_frsize
    return {"totalBytes": total, "freeBytes": free, "usedBytes": compute_used(stats)}


def compute_used(stats):
    """Bytes in use the way `df` counts them: total minus free for root."""
    return (stats.f_blocks - stats.f_bfree) * stats.f_frsize


def nearest_existing(path):
    path = Path(path)
    while not path.exists():
        if path.parent == path:
            break
        path = path.parent
    return path


def looks_like_library(path):
    """True when the directory already holds an Immich library with content."""
    path = Path(path)
    try:
        names = {entry.name for entry in path.iterdir()}
    except OSError:
        return False
    if not names & {"library", "upload"}:
        return False
    for name in ("library", "upload"):
        try:
            for user_dir in (path / name).iterdir():
                if user_dir.is_dir() and any(user_dir.iterdir()):
                    return True
        except OSError:
            continue
    return False


def check_storage(path, purpose="media", mount_lookup=mount_info, usage_lookup=disk_usage):
    """Decide whether `path` is a safe place for the media or the database.

    Returns a dict with `ok`, `errors`, `warnings` and what was found. Nothing
    is created or changed.
    """
    result = {"path": str(path), "purpose": purpose, "ok": False, "exists": False, "writable": False,
              "mounted": False, "mountPoint": None, "device": None, "filesystem": None,
              "network": False, "totalBytes": None, "usedBytes": None, "freeBytes": None,
              "existingLibrary": False, "empty": True, "errors": [], "warnings": []}
    errors, warnings = result["errors"], result["warnings"]

    raw = str(path).strip()
    if not raw:
        errors.append("No path given.")
        return result
    target = Path(raw).expanduser()
    if not target.is_absolute():
        errors.append("The path must be absolute, for example %s." % (Path.home() / "Pictures/Immich"))
        return result
    target = Path(os.path.normpath(target))
    result["path"] = str(target)

    if str(target) == "/":
        errors.append("The filesystem root is not a valid location.")
        return result
    for system_path in SYSTEM_PATHS:
        if target == Path(system_path) or Path(system_path) in target.parents:
            errors.append("%s is a system directory and not a place for photos." % system_path)
            return result

    result["exists"] = target.is_dir()
    if target.exists() and not target.is_dir():
        errors.append("%s exists but is not a directory." % target)
        return result

    anchor = nearest_existing(target)
    mount = mount_lookup(anchor)
    if not mount or not mount.get("fstype"):
        errors.append("Could not determine which filesystem holds %s." % anchor)
        return result
    fstype = mount["fstype"]
    result.update(mounted=True, mountPoint=mount.get("target"), device=mount.get("source"), filesystem=fstype)

    for parent in MOUNT_PARENTS:
        if (target == Path(parent) or Path(parent) in target.parents) and mount.get("target") == "/":
            result["mounted"] = False
            errors.append(
                "No disk is mounted at this location: %s lies on the system disk. "
                "Mount the drive first, then check again." % target)
            return result

    base_type = fstype.split(".")[0]
    if base_type in VOLATILE_FS:
        errors.append("%s is a temporary filesystem (%s). Data would be lost on reboot." % (mount["target"], fstype))
    if fstype in UNSUITABLE_FS:
        errors.append("Filesystem %s has no Unix ownership and permissions, which Immich requires." % fstype)
    if base_type in NETWORK_FS or fstype in ("fuse.sshfs", "fuse.rclone"):
        result["network"] = True
        if purpose == "database":
            errors.append("The database must not live on a network share (%s)." % fstype)
        else:
            warnings.append("Network share (%s): uploads stop when the share is unavailable." % fstype)
    if "ro" in mount.get("options", []):
        errors.append("%s is mounted read-only." % mount["target"])

    result["writable"] = os.access(anchor, os.W_OK | os.X_OK)
    if not result["writable"]:
        errors.append("Your user cannot write to %s." % anchor)

    try:
        result.update(usage_lookup(anchor))
    except OSError as error:
        errors.append("Could not read free space of %s: %s." % (anchor, error.strerror))
    else:
        free = result["freeBytes"]
        if free < MIN_FREE_BYTES:
            errors.append("Storage is full: only %s free on %s." % (format_bytes(free), mount["target"]))
        elif free < LOW_FREE_BYTES:
            warnings.append("Only %s free on %s." % (format_bytes(free), mount["target"]))

    if result["exists"]:
        try:
            entries = [entry.name for entry in target.iterdir()]
        except OSError:
            entries = []
        result["empty"] = not entries
        result["existingLibrary"] = looks_like_library(target)
        if result["existingLibrary"]:
            warnings.append("This folder already contains an Immich library. It will not be modified.")
        elif entries and not set(entries) <= IMMICH_LIBRARY_DIRS:
            warnings.append("This folder is not empty. Immich will add its own subfolders next to the existing files.")

    result["ok"] = not errors
    return result


