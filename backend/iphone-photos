def system_timezone():
    code, out, _ = run(["timedatectl", "show", "-p", "Timezone", "--value"])
    if code == 0 and out:
        return out
    try:
        return os.readlink("/etc/localtime").split("zoneinfo/")[1]
    except (OSError, IndexError):
        return None


def generate_password(length=40):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


def render_env(template, values):
    """Fill the official example.env. Only variables the template knows are set."""
    lines, applied = [], set()
    for line in template.splitlines():
        match = re.match(r"^(#\s*)?([A-Z_]+)=", line)
        if match and match.group(2) in values and match.group(2) not in applied:
            line = "%s=%s" % (match.group(2), values[match.group(2)])
            applied.add(match.group(2))
        lines.append(line)
    return "\n".join(lines) + "\n", applied


def verify_release_file(name, data):
    """Refuse a release file whose content is not the one this plugin was reviewed with."""
    if hashlib.sha256(data).hexdigest() != RELEASE_SHA256.get(name):
        fail("%s from Immich %s does not match the expected checksum. Nothing was installed."
             % (name, IMMICH_RELEASE))
    return data.decode()


def download(name):
    request = urllib.request.Request(RELEASE_URL + name, headers={"User-Agent": APP})
    with urllib.request.urlopen(request, timeout=30) as response:
        return verify_release_file(name, response.read())


def setup(media, database=None, compose_dir=None, fetch=download):
    """Prepare the official Immich compose project. Does not start anything."""
    existing = find_installation()
    if existing.installed:
        fail("Immich is already installed in %s. Nothing was changed." % existing.compose_dir,
             "iphone-photos integrate %s" % existing.compose_dir, code=3)
    if port_listening(CONTAINER_PORT):
        fail("Port %d is already in use by another program. Nothing was changed." % CONTAINER_PORT,
             "Find it with: ss -ltnp | grep %d" % CONTAINER_PORT, code=3)

    compose_dir = Path(compose_dir) if compose_dir else default_compose_dir()
    database = Path(database).expanduser() if database else data_dir() / "postgres"
    if (compose_dir / ".env").exists():
        fail("%s already exists and will not be replaced." % (compose_dir / ".env"), code=3)

    media_check = check_storage(media, "media")
    db_check = check_storage(database, "database")
    for check in (media_check, db_check):
        for warning in check["warnings"]:
            print("Warning (%s): %s" % (check["purpose"], warning), file=sys.stderr)
        if not check["ok"]:
            fail("The %s location %s is not usable:\n  %s" % (check["purpose"], check["path"],
                                                               "\n  ".join(check["errors"])), code=2)
    if db_check["exists"] and not db_check["empty"]:
        fail("The database folder %s is not empty and will not be reused." % database, code=3)

    compose = fetch("docker-compose.yml")
    template = fetch("example.env")
    if "immich-server" not in compose or "UPLOAD_LOCATION" not in template:
        fail("The files downloaded from the Immich release look wrong. Nothing was installed.")

    values = {"UPLOAD_LOCATION": media_check["path"], "DB_DATA_LOCATION": db_check["path"],
              "DB_PASSWORD": generate_password()}
    zone = system_timezone()
    if zone:
        values["TZ"] = zone
    env_text, applied = render_env(template, values)
    for required in ("UPLOAD_LOCATION", "DB_DATA_LOCATION", "DB_PASSWORD"):
        if required not in applied:
            fail("This Immich release no longer uses %s. The installer needs an update." % required)

    data_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    compose_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    Path(database).mkdir(parents=True, exist_ok=True, mode=0o700)
    Path(media_check["path"]).mkdir(parents=True, exist_ok=True)
    if db_check["filesystem"] == "btrfs":
        # Copy-on-write fragments database files; must be set while empty.
        run(["chattr", "+C", str(database)])
    write_private(compose_dir / "docker-compose.yml", compose)
    write_private(compose_dir / ".env", env_text)

    config = load_config()
    config["composeDir"] = str(compose_dir)
    save_config(config)
    print("Immich is prepared in %s" % compose_dir)
    print("  Photos and videos: %s" % media_check["path"])
    print("  Database:          %s" % db_check["path"])
    return 0


def integrate(compose_dir):
    installation = Installation(Path(compose_dir).expanduser().resolve())
    if not installation.installed:
        fail("No Immich compose file found in %s." % installation.compose_dir)
    config = load_config()
    config["composeDir"] = str(installation.compose_dir)
    save_config(config)
    print("Using the existing Immich installation in %s" % installation.compose_dir)
    print("  Photos and videos: %s" % (installation.media_path or "unknown"))
    print("  Port:              %d" % installation.port)
    return 0


