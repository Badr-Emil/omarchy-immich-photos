class ApiError(Exception):
    def __init__(self, kind, message, status=None):
        super().__init__(message)
        self.kind = kind
        self.status = status


class ImmichApi:
    """Minimal client for the documented Immich REST API (OpenAPI v3.x)."""

    def __init__(self, base_url, api_key=None, timeout=4):
        self.base_url = base_url.rstrip("/")
        self.api_key = api_key
        self.timeout = timeout

    def get(self, path, authenticated=False):
        return self.request("GET", path, authenticated=authenticated)

    def request(self, method, path, body=None, authenticated=True, raw=False, timeout=None):
        """One API call. Returns parsed JSON, or the raw bytes when `raw` is set."""
        timeout = timeout or self.timeout
        headers = {"Accept": "application/octet-stream" if raw else "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(self.base_url + "/api" + path, data=data, headers=headers, method=method)
        if authenticated:
            if not self.api_key:
                raise ApiError("no-key", "No API key configured.")
            request.add_header("x-api-key", self.api_key)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = response.read()
        except urllib.error.HTTPError as error:
            error.close()
            if error.code == 401:
                raise ApiError("unauthorized", "The API key was rejected.", 401)
            if error.code == 403:
                raise ApiError("forbidden", "The API key lacks the permission for %s." % path, 403)
            raise ApiError("http", "Immich answered %s with HTTP %d." % (path, error.code), error.code)
        except (TimeoutError, socket.timeout):
            raise ApiError("timeout", "Immich did not answer within %d seconds." % timeout)
        except (urllib.error.URLError, OSError) as error:
            reason = getattr(error, "reason", error)
            if isinstance(reason, (TimeoutError, socket.timeout)):
                raise ApiError("timeout", "Immich did not answer within %d seconds." % timeout)
            raise ApiError("unreachable", "Immich is not reachable at %s." % self.base_url)
        if raw:
            return payload
        if not payload:
            return None
        try:
            return json.loads(payload)
        except ValueError:
            raise ApiError("invalid", "Immich returned something that is not JSON for %s." % path)

    def ping(self):
        return self.get("/server/ping").get("res") == "pong"

    def version(self):
        data = self.get("/server/version")
        return "%s.%s.%s" % (data["major"], data["minor"], data["patch"])


def read_api_key():
    try:
        key = (config_dir() / "api-key").read_text().strip()
        return key or None
    except OSError:
        return None


def summarize_queues(queues):
    """Reduce GET /queues to totals plus the queues that have work."""
    totals = {"active": 0, "waiting": 0, "delayed": 0, "failed": 0, "paused": 0}
    busy = []
    for queue in queues:
        stats = queue.get("statistics") or {}
        for key in totals:
            totals[key] += int(stats.get(key) or 0)
        pending = int(stats.get("active") or 0) + int(stats.get("waiting") or 0)
        if pending:
            busy.append({"name": queue.get("name"), "pending": pending, "paused": bool(queue.get("isPaused"))})
    totals["pending"] = totals["active"] + totals["waiting"] + totals["delayed"] + totals["paused"]
    totals["queues"] = sorted(busy, key=lambda item: -item["pending"])
    return totals


def summarize_sessions(sessions):
    """Devices signed in to the account and when the server last saw them.

    Immich refreshes a session's timestamp at most once per hour, so "last
    seen" is accurate to about an hour.
    """
    devices = []
    for session in sessions:
        if not (session.get("deviceType") or session.get("deviceOS")):
            continue
        devices.append({"deviceType": session.get("deviceType") or "", "deviceOS": session.get("deviceOS") or "",
                        "appVersion": session.get("appVersion"), "lastSeen": session.get("updatedAt")})
    devices.sort(key=lambda device: device["lastSeen"] or "", reverse=True)
    return devices


def is_iphone(device):
    return "ios" in device["deviceOS"].lower() or "iphone" in device["deviceType"].lower()


def derive_state(installed, docker_present, daemon_active, port_open, ping_ok, maintenance=False, pending_jobs=0):
    """Single word describing the whole setup, plus what to tell the user."""
    if not docker_present:
        return ("no-docker", "Docker is not installed.",
                "Install it with: omarchy pkg add docker docker-compose")
    if not installed:
        return ("not-installed", "Immich is not installed.", "Run scripts/install.sh")
    if ping_ok:
        if maintenance:
            return ("problem", "Immich is in maintenance mode.", "Open the web interface to finish maintenance.")
        if pending_jobs:
            return ("busy", "Immich is online and processing %d jobs." % pending_jobs, "")
        return ("online", "Immich is online.", "")
    if not daemon_active:
        return ("stopped", "Immich server is not reachable.\nThe Docker daemon is not running.",
                "iphone-photos server start")
    if not port_open:
        return ("stopped", "Immich server is not reachable.\nDocker container immich_server is stopped.",
                "iphone-photos server start")
    return ("problem", "Immich server is not answering.\nThe port is open but the API does not respond; "
            "the server may still be starting.", "iphone-photos server logs")


