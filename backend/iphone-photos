def build_parser():
    parser = argparse.ArgumentParser(prog="iphone-photos", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)

    status = commands.add_parser("status", help="overall status")
    status.add_argument("--json", action="store_true")

    server = commands.add_parser("server", help="control the Immich containers")
    server.add_argument("action", choices=["status", "start", "stop", "restart", "logs"])
    server.add_argument("--tail", type=int, default=100)

    storage = commands.add_parser("storage", help="storage status and path checks")
    storage.add_argument("action", choices=["status", "check"])
    storage.add_argument("path", nargs="?")
    storage.add_argument("--database", action="store_true", help="check as a database location")
    storage.add_argument("--json", action="store_true")

    backup = commands.add_parser("backup", help="backup status")
    backup.add_argument("action", choices=["status"])
    backup.add_argument("--json", action="store_true")

    address = commands.add_parser("address", help="server address for the iPhone")
    address.add_argument("--qr", action="store_true", help="show a QR code in the terminal")
    address.add_argument("--qr-file", metavar="PNG", help="write the QR code to a PNG file")

    api_key = commands.add_parser("api-key", help="store the Immich API key")
    api_key.add_argument("action", choices=["set", "clear", "status"])

    open_parser = commands.add_parser("open", help="open the Immich gallery in its own window")
    open_parser.add_argument("--browser", action="store_true", help="open a normal browser tab instead")
    commands.add_parser("diagnostics", help="full report without secrets")

    gallery = commands.add_parser("gallery", help="photo browser data and actions (JSON)")
    gallery.add_argument("action", choices=["list", "preview", "albums", "play", "trash", "restore",
                                            "favorite", "archive", "album-add", "album-create"])
    gallery.add_argument("arguments", nargs="*")

    setup_parser = commands.add_parser("setup", help="prepare a new Immich installation")
    setup_parser.add_argument("--media", required=True)
    setup_parser.add_argument("--database")

    integrate_parser = commands.add_parser("integrate", help="use an existing Immich installation")
    integrate_parser.add_argument("compose_dir")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    command = args.command

    if command == "setup":
        return setup(args.media, args.database)
    if command == "integrate":
        return integrate(args.compose_dir)

    installation = find_installation()

    if command == "status":
        status = collect_status(installation)
        if args.json:
            print(json.dumps(status))
        else:
            print_status(status)
        return 0

    if command == "diagnostics":
        print_diagnostics(collect_status(installation), installation)
        return 0

    if command == "gallery":
        try:
            print(json.dumps(gallery_command(installation, args.action, args.arguments)))
            return 0
        except GalleryError as error:
            print(json.dumps({"error": {"kind": error.kind, "message": str(error)}}))
            return 1

    if command == "server":
        if args.action == "status":
            return run_compose(installation, "ps", "-a")
        if args.action == "logs":
            return run_compose(installation, "logs", "--no-color", "--tail", str(max(1, args.tail)))
        if args.action == "stop":
            return run_compose(installation, "stop")
        code = run_compose(installation, *(("up", "-d") if args.action == "start" else ("restart",)))
        if code != 0:
            fail("Docker could not %s Immich (exit code %d)." % (args.action, code), "iphone-photos server logs")
        print("Waiting for Immich to answer…")
        if not wait_until_online(installation):
            fail("The containers were started but Immich is not answering yet.", "iphone-photos server logs")
        print("Immich is online at http://localhost:%d" % installation.port)
        return 0

    if command == "storage":
        if args.action == "check":
            if not args.path:
                fail("Give the path to check, for example: iphone-photos storage check ~/Pictures/Immich")
            check = check_storage(args.path, "database" if args.database else "media")
            if args.json:
                print(json.dumps(check))
            else:
                print_storage_check(check)
            return 0 if check["ok"] else 2
        media = installation.media_path
        if media is None:
            fail("Immich is not installed, so there is no storage location yet.", "Run scripts/install.sh")
        check = check_storage(media, "media")
        if args.json:
            print(json.dumps(check))
        else:
            print_storage_check(check)
        return 0 if check["ok"] else 2

    if command == "backup":
        result = backup_status(installation)
        if args.json:
            print(json.dumps(result))
            return 0
        database = result["database"]
        section("Backup", [
            ("Media backup", "configured: %s" % result["media"]["target"] if result["media"]["configured"]
             else "not configured"),
            ("Database dumps", "%d, newest %s" % (database["count"], database["latest"])
             if database["configured"] else "none yet (Immich creates them nightly)"),
            ("Last verified", result["lastVerified"] or "never"),
        ])
        for note in result["notes"]:
            print("Note: %s" % note)
        return 0

    if command == "address":
        address = lan_ip()
        if not address:
            fail("This PC has no local network address. Connect to your Wi-Fi or LAN first.")
        url = "http://%s:%d" % (address, installation.port)
        if args.qr_file:
            write_qr(url, args.qr_file)
        print(url)
        if args.qr:
            subprocess.call(["qrencode", "-t", "ANSIUTF8", "-m", "2", url])
        return 0

    if command == "api-key":
        path = config_dir() / "api-key"
        if args.action == "status":
            print("configured" if read_api_key() else "not configured")
            return 0
        if args.action == "clear":
            path.unlink(missing_ok=True)
            print("API key removed.")
            return 0
        key = (getpass.getpass("Immich API key: ") if sys.stdin.isatty() else sys.stdin.readline()).strip()
        if not re.fullmatch(r"[A-Za-z0-9_\-]{20,200}", key):
            fail("That does not look like an Immich API key. Nothing was saved.")
        try:
            ImmichApi("http://127.0.0.1:%d" % installation.port, key).get("/api-keys/me", authenticated=True)
        except ApiError as error:
            if error.kind in ("unauthorized", "forbidden"):
                fail("Immich rejected this key. Nothing was saved.")
            print("Immich is not reachable right now; the key is saved unchecked.", file=sys.stderr)
        config_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        write_private(path, key + "\n")
        print("API key saved.")
        return 0

    if command == "open":
        url = "http://localhost:%d" % installation.port
        # Omarchy's web app launcher gives the gallery its own window without
        # browser chrome; a plain browser tab is the fallback.
        launcher = None if args.browser else shutil.which("omarchy-launch-webapp")
        subprocess.Popen([launcher, url] if launcher else ["xdg-open", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
