def config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / APP


def data_dir():
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / APP


def default_compose_dir():
    return data_dir() / "immich"


def load_config():
    try:
        config = json.loads((config_dir() / "config.json").read_text())
        return config if isinstance(config, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(config):
    config_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    write_private(config_dir() / "config.json", json.dumps(config, indent=2) + "\n")


def write_private(path, text):
    """Write a file that only the owner can read, without a readable window."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    os.chmod(path, 0o600)


def parse_env(text):
    """Parse a docker compose .env file into a dict."""
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export "):].strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        else:
            value = re.sub(r"\s+#.*$", "", value)
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            values[key] = value
    return values


def parse_host_port(compose_text):
    """Host port that the compose file publishes for the Immich server."""
    match = re.search(
        r"^\s*-\s*['\"]?(?:[0-9.]+:)?(\d+):%d(?:/tcp)?['\"]?\s*$" % CONTAINER_PORT,
        compose_text,
        re.MULTILINE,
    )
    return int(match.group(1)) if match else CONTAINER_PORT


def is_immich_compose(directory):
    for name in ("docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"):
        path = Path(directory) / name
        try:
            if "immich-server" in path.read_text():
                return path
        except OSError:
            continue
    return None


class Installation:
    """What is known about the Immich compose project on this machine."""

    def __init__(self, compose_dir):
        self.compose_dir = Path(compose_dir)
        self.compose_file = is_immich_compose(self.compose_dir)
        self.env = {}
        self.port = CONTAINER_PORT
        if self.compose_file:
            try:
                self.port = parse_host_port(self.compose_file.read_text())
                self.env = parse_env((self.compose_dir / ".env").read_text())
            except OSError:
                pass

    @property
    def installed(self):
        return self.compose_file is not None

    def _location(self, key):
        value = self.env.get(key)
        if not value:
            return None
        path = Path(value).expanduser()
        return path if path.is_absolute() else (self.compose_dir / path).resolve()

    @property
    def media_path(self):
        return self._location("UPLOAD_LOCATION")

    @property
    def db_path(self):
        return self._location("DB_DATA_LOCATION")


def find_installation(config=None):
    """Locate an Immich compose project: configured, ours, or a common place."""
    config = load_config() if config is None else config
    candidates = []
    if config.get("composeDir"):
        candidates.append(Path(config["composeDir"]))
    candidates.append(default_compose_dir())
    home = Path.home()
    candidates += [home / "immich-app", home / "immich", home / "docker/immich",
                   Path("/opt/immich"), Path("/opt/immich-app"), Path("/srv/immich")]
    for directory in running_compose_dirs():
        candidates.append(directory)
    for candidate in candidates:
        installation = Installation(candidate)
        if installation.installed:
            return installation
    return Installation(candidates[0])


