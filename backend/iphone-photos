def note(notes, code, text):
    """A hint for the user: `code` for the panel, `text` for the terminal."""
    notes.append({"code": code, "text": text})


def collect_status(installation=None):
    installation = installation or find_installation()
    port = installation.port
    local_url = "http://localhost:%d" % port
    address = lan_ip()
    direct = docker_direct()
    api_key = read_api_key()
    api = ImmichApi("http://127.0.0.1:%d" % port, api_key)
    notes = []
    library_bytes = None

    status = {
        "schema": 1,
        "installed": installation.installed,
        "composeDir": str(installation.compose_dir) if installation.installed else None,
        "server": {"online": False, "version": None, "initialized": None, "maintenanceMode": None,
                   "port": port, "portListening": port_listening(port), "lanIp": address,
                   "localUrl": local_url, "url": "http://%s:%d" % (address, port) if address else None},
        "docker": {"installed": docker_installed(), "daemonActive": docker_daemon_active(),
                   "enabledAtBoot": docker_enabled_at_boot(), "direct": direct,
                   "containers": container_states(installation)},
        "database": {"status": "unknown", "inferred": True},
        "storage": None,
        "library": None,
        "jobs": None,
        "devices": None,
        "lastActivity": None,
        "capabilities": {"dockerDirect": direct, "apiKey": api_key is not None,
                         "userApi": False, "adminApi": False},
        "notes": notes,
    }
    server = status["server"]

    if installation.installed:
        try:
            server["online"] = api.ping()
        except ApiError:
            server["online"] = False
    if server["online"]:
        status["database"]["status"] = "reachable"
        try:
            server["version"] = api.version()
            config = api.get("/server/config")
            server["initialized"] = bool(config.get("isInitialized"))
            server["maintenanceMode"] = bool(config.get("maintenanceMode"))
        except (ApiError, KeyError, TypeError):
            pass
        if server["initialized"] is False:
            note(notes, "no-admin", "No admin account yet. Open %s and create one." % local_url)
        elif not api_key:
            note(notes, "no-key", "No API key configured: photo counts and job status are not available. "
                 "Run: iphone-photos api-key set")
        else:
            library_bytes = collect_authenticated(api, status, notes)
    elif status["docker"]["containers"] is not None:
        postgres = [c for c in status["docker"]["containers"] if "postgres" in c["name"] or c["service"] == "database"]
        if postgres:
            status["database"] = {"status": postgres[0]["health"] or postgres[0]["state"], "inferred": False}

    media = installation.media_path
    if media is not None:
        storage = {"path": str(media), "exists": media.is_dir(), "mounted": None, "filesystem": None,
                   "mountPoint": None, "totalBytes": None, "usedBytes": None, "freeBytes": None,
                   "libraryBytes": library_bytes}
        mount = mount_info(nearest_existing(media))
        if mount:
            storage.update(filesystem=mount["fstype"], mountPoint=mount["target"], mounted=True)
            if any(str(media).startswith(parent + "/") for parent in MOUNT_PARENTS) and mount["target"] == "/":
                storage["mounted"] = False
                note(notes, "not-mounted", "The disk for %s is not mounted." % media)
        if storage["exists"]:
            try:
                storage.update(disk_usage(media))
            except OSError:
                pass
        else:
            note(notes, "no-media-folder", "The media folder %s does not exist." % media)
        if storage["freeBytes"] is not None and storage["freeBytes"] < LOW_FREE_BYTES:
            note(notes, "low-space", "Storage is running low: %s free." % format_bytes(storage["freeBytes"]))
        status["storage"] = storage

    pending = (status["jobs"] or {}).get("pending", 0)
    state, message, suggestion = derive_state(
        installation.installed, status["docker"]["installed"], status["docker"]["daemonActive"],
        server["portListening"], server["online"], bool(server["maintenanceMode"]), pending)
    status.update(state=state, message=message, suggestion=suggestion)
    return status


def collect_authenticated(api, status, notes):
    """Fill in everything that needs the API key. Each part degrades alone.

    Returns the size of the library in bytes when the key may read it.
    """
    capabilities = status["capabilities"]
    library_bytes = None
    try:
        stats = api.get("/server/statistics", authenticated=True)
        status["library"] = {"photos": int(stats["photos"]), "videos": int(stats["videos"]), "scope": "server"}
        library_bytes = int(stats["usage"])
        capabilities["adminApi"] = capabilities["userApi"] = True
    except ApiError as error:
        if error.kind == "unauthorized":
            note(notes, "key-rejected", "The API key was rejected. Create a new one and run: iphone-photos api-key set")
            return None
        try:
            stats = api.get("/assets/statistics", authenticated=True)
            status["library"] = {"photos": int(stats["images"]), "videos": int(stats["videos"]), "scope": "user"}
            capabilities["userApi"] = True
        except (ApiError, KeyError, TypeError, ValueError):
            note(notes, "key-permissions", "The API key cannot read statistics (permission asset.statistics or server.statistics).")
    except (KeyError, TypeError, ValueError):
        pass
    try:
        status["jobs"] = summarize_queues(api.get("/queues", authenticated=True))
    except (ApiError, AttributeError, TypeError, ValueError):
        pass
    try:
        devices = summarize_sessions(api.get("/sessions", authenticated=True))
        status["devices"] = devices
        phones = [device for device in devices if is_iphone(device)] or devices
        status["lastActivity"] = phones[0]["lastSeen"] if phones else None
    except (ApiError, AttributeError, TypeError, ValueError):
        pass
    return library_bytes


def backup_status(installation=None):
    """What can be said about backups today. Configuring one is not built yet."""
    installation = installation or find_installation()
    config = load_config()
    result = {"media": {"configured": False, "target": config.get("backupTarget")},
              "database": {"configured": False, "count": 0, "latest": None, "location": None},
              "lastVerified": None, "notes": []}
    media = installation.media_path
    if media is not None:
        dumps_dir = media / "backups"
        result["database"]["location"] = str(dumps_dir)
        try:
            dumps = sorted((entry for entry in dumps_dir.iterdir() if entry.name.endswith((".sql.gz", ".sql"))),
                           key=lambda entry: entry.stat().st_mtime)
        except OSError:
            dumps = []
        if dumps:
            latest = datetime.fromtimestamp(dumps[-1].stat().st_mtime, timezone.utc)
            result["database"].update(configured=True, count=len(dumps), latest=latest.isoformat())
    result["notes"].append(
        "Immich's database dumps are stored on the same disk as the photos. "
        "They do not replace a backup of the photos and videos.")
    if not result["media"]["target"]:
        result["notes"].append("No backup target for photos and videos is configured.")
    return result


