def elevation():
    """sudo asks in the terminal; without a terminal only polkit can ask."""
    return "sudo" if sys.stdin.isatty() and shutil.which("sudo") else "pkexec"


def compose_command(installation, *arguments):
    """Fixed-shape compose invocation, elevated when access is not direct."""
    command = ["docker", "compose", "--project-directory", str(installation.compose_dir), *arguments]
    if not docker_direct():
        command = [elevation(), *command]
    return command


def run_compose(installation, *arguments):
    if not docker_installed():
        fail("Docker is not installed.", "omarchy pkg add docker docker-compose")
    if not installation.installed:
        fail("Immich is not installed.", "Run scripts/install.sh")
    if not docker_direct():
        print("Docker needs administrator rights; you will be asked for your password.", file=sys.stderr)
    try:
        return subprocess.call(compose_command(installation, *arguments))
    except FileNotFoundError as error:
        fail("%s is not available." % error.filename)
    except KeyboardInterrupt:
        return 130


def wait_until_online(installation, seconds=120):
    api = ImmichApi("http://127.0.0.1:%d" % installation.port)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            if api.ping():
                return True
        except ApiError:
            pass
        time.sleep(2)
    return False


