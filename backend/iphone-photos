def format_bytes(value):
    if value is None:
        return "unknown"
    value = float(value)
    for unit in ("B", "KB", "MB", "GB"):
        if value < 1024:
            break
        value /= 1024
    else:
        unit = "TB"
    return "%d %s" % (value, unit) if unit == "B" or value >= 100 else "%.1f %s" % (value, unit)


def fail(message, suggestion=None, code=1):
    print(message, file=sys.stderr)
    if suggestion:
        print("\nSuggested action:\n%s" % suggestion, file=sys.stderr)
    sys.exit(code)


def section(title, rows):
    print(title)
    width = max(len(label) for label, _ in rows) + 1
    for label, value in rows:
        print("  %-*s %s" % (width, label + ":", value))
    print()


def print_status(status):
    server, storage = status["server"], status["storage"]
    labels = {"online": "Online", "busy": "Online, processing", "stopped": "Stopped", "problem": "Problem",
              "not-installed": "Not installed", "no-docker": "Docker missing"}
    section("Immich Server", [
        ("Status", labels[status["state"]]),
        ("Version", server["version"] or "unknown"),
        ("Address", server["url"] or "no LAN address (%s works on this PC only)" % server["localUrl"]),
    ])
    if status["library"]:
        scope = "whole server" if status["library"]["scope"] == "server" else "your account"
        section("Library (%s)" % scope, [("Photos", status["library"]["photos"]),
                                         ("Videos", status["library"]["videos"])])
    if status["jobs"]:
        section("Jobs", [("Pending", status["jobs"]["pending"]), ("Failed", status["jobs"]["failed"])])
    if storage:
        rows = [("Path", storage["path"])]
        if storage["libraryBytes"] is not None:
            rows.append(("Library", format_bytes(storage["libraryBytes"])))
        rows += [("Used", format_bytes(storage["usedBytes"])), ("Free", format_bytes(storage["freeBytes"]))]
        section("Storage", rows)
    section("Docker", [("Status", "Running" if status["docker"]["daemonActive"] else "Not running")])
    database = status["database"]["status"]
    section("Database", [("Status", "Healthy (server is answering)" if database == "reachable" else database)])
    if status["lastActivity"]:
        section("iPhone", [("Last seen", status["lastActivity"] + " (accurate to about an hour)")])
    for entry in status["notes"]:
        print("Note: %s" % entry["text"])
    if status["state"] not in ("online", "busy"):
        print(status["message"])
        if status["suggestion"]:
            print("\nSuggested action:\n%s" % status["suggestion"])


def print_storage_check(check):
    section("Storage check", [
        ("Path", check["path"]),
        ("Exists", "yes" if check["exists"] else "no (will be created)"),
        ("Mounted", ("yes, %s on %s" % (check["device"], check["mountPoint"])) if check["mounted"] else "no"),
        ("Filesystem", check["filesystem"] or "unknown"),
        ("Writable", "yes" if check["writable"] else "no"),
        ("Free", format_bytes(check["freeBytes"])),
        ("Result", "suitable" if check["ok"] else "NOT suitable"),
    ])
    for error in check["errors"]:
        print("Error: %s" % error)
    for warning in check["warnings"]:
        print("Warning: %s" % warning)


def print_diagnostics(status, installation):
    code, omarchy, _ = run(["omarchy", "version"])
    section("Omarchy", [("Version", omarchy if code == 0 and omarchy else "unknown")])
    docker = status["docker"]
    section("Docker", [
        ("Engine", engine_version() or "not installed"),
        ("Compose", compose_version() or "not installed"),
        ("Running", "yes" if docker["daemonActive"] else "no"),
        ("Starts at boot", "yes" if docker["enabledAtBoot"] else "no"),
        ("Access", "direct (docker group)" if docker["direct"] else "through password prompt (pkexec)"),
    ])
    server = status["server"]
    section("Immich", [
        ("Installed", "yes, %s" % status["composeDir"] if status["installed"] else "no"),
        ("Online", "yes" if server["online"] else "no"),
        ("Version", server["version"] or "unknown"),
        ("URL", server["url"] or server["localUrl"]),
        ("Admin account", {True: "created", False: "not created yet", None: "unknown"}[server["initialized"]]),
        ("API key", "configured" if status["capabilities"]["apiKey"] else "not configured"),
    ])
    storage = status["storage"]
    if storage:
        section("Storage", [
            ("Path", storage["path"]),
            ("Filesystem", storage["filesystem"] or "unknown"),
            ("Mounted", {True: "yes", False: "NO", None: "unknown"}[storage["mounted"]]),
            ("Free", format_bytes(storage["freeBytes"])),
            ("Database path", str(installation.db_path) if installation.db_path else "unknown"),
        ])
    section("Network", [
        ("LAN IP", server["lanIp"] or "none found"),
        ("Port %d" % server["port"], "listening" if server["portListening"] else "closed"),
    ])
    database = status["database"]
    section("Database", [("Status", "healthy (inferred: server is answering)"
                          if database["status"] == "reachable" else database["status"])])
    if docker["containers"]:
        section("Containers", [(c["name"], " ".join(filter(None, [c["state"], c["health"]])))
                               for c in docker["containers"]])
    elif status["installed"]:
        print("Container details need Docker access: iphone-photos server status\n")
    for entry in status["notes"]:
        print("Note: %s" % entry["text"])
    if status["state"] not in ("online", "busy"):
        print(status["message"])
        if status["suggestion"]:
            print("\nSuggested action:\n%s" % status["suggestion"])


def write_qr(url, path):
    """QR code that contains the server address and nothing else."""
    if not shutil.which("qrencode"):
        fail("qrencode is not installed.", "omarchy pkg add qrencode")
    Path(path).parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    code, _, err = run(["qrencode", "-o", str(path), "-s", "8", "-m", "2", "-l", "M", url])
    if code != 0:
        fail("Could not create the QR code: %s" % err)


