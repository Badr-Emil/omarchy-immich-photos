APP = "omarchy-iphone-photos"
CONTAINER_PORT = 2283
# The compose file runs as root through Docker, so it is pinned to a release
# and checked against the hashes below instead of following "latest". A newer
# Immich release is adopted by updating these three values in a plugin commit.
IMMICH_RELEASE = "v3.2.4"
RELEASE_URL = "https://github.com/immich-app/immich/releases/download/%s/" % IMMICH_RELEASE
RELEASE_SHA256 = {
    "docker-compose.yml": "fa98c3eb0884b0b88aaee11a9c9acb8cfb17a0f495d12c21358deb6d3e8a546b",
    "example.env": "dda820cecbcf5fd5d6afecc54107bbd3c973088c631d380dfc83e9f0f2c6b210",
}
DOCKER_SOCKET = "/var/run/docker.sock"

GIB = 1024**3
MIN_FREE_BYTES = 1 * GIB
LOW_FREE_BYTES = 20 * GIB

# Filesystems without Unix ownership and permissions, which Immich requires.
UNSUITABLE_FS = {"vfat", "exfat", "msdos", "ntfs", "ntfs3", "fuseblk", "iso9660", "udf"}
NETWORK_FS = {"nfs", "nfs4", "cifs", "smb3", "smbfs", "9p", "ceph", "glusterfs", "davfs"}
VOLATILE_FS = {"tmpfs", "ramfs", "devtmpfs", "proc", "sysfs", "overlay"}
# Places that only make sense as a mount point of a separate disk.
MOUNT_PARENTS = ("/mnt", "/media", "/run/media")
SYSTEM_PATHS = ("/boot", "/dev", "/etc", "/proc", "/run", "/sys", "/tmp", "/usr", "/var/lib/docker")
IMMICH_LIBRARY_DIRS = {"library", "upload", "thumbs", "encoded-video", "profile", "backups"}


# --------------------------------------------------------------------------
# Paths and configuration
